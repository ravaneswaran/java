<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001" author="Ravaneswaran Chinnasamy">
        <createTable tableName="nse_top20_detail">
            <column name="id" type="varchar2(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="stock_base_id" type="varchar2(100)"/>
            <column name="top20_type" type="varchar2(100)"/>
            <column name="symbol" type="varchar2(100)"/>
            <column name="open_price" type="double"/>
            <column name="high_price" type="double"/>
            <column name="low_price" type="double"/>
            <column name="previous_close_price" type="double"/>
            <column name="last_traded_price" type="double"/>
            <column name="percentage_change" type="double"/>
            <column name="volume_in_shares" type="int"/>
            <column name="value_in_lakhs" type="double"/>
            <column name="ca" type="datetime"/>
            <column name="created_date" type="datetime"/>
            <column name="modified_date" type="datetime"/>
            <column name="created_by" type="varchar2(100)"/>
            <column name="modified_by" type="varchar2(100)"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="nse_top20_detail"
                baseColumnNames="stock_base_id"
                constraintName="fk_nse_top20_detail_nse_stock_base"
                referencedTableName="nse_stock_base"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="002" author="Ravaneswaran Chinnasamy">
        <sql>
            ALTER TABLE nse_top20_detail
            ADD top20_sub_type VARCHAR(50)
            AFTER top20_type;
        </sql>
    </changeSet>

    <changeSet id="003" author="Ravaneswaran Chinnasamy">
        <dropForeignKeyConstraint
                baseTableName="nse_top20_detail"
                constraintName="fk_nse_top20_detail_nse_stock_base"/>
    </changeSet>

    <changeSet id="004" author="Ravaneswaran Chinnasamy">
        <addForeignKeyConstraint
                baseTableName="nse_top20_detail"
                baseColumnNames="stock_base_id"
                constraintName="fk_nse_top20_detail_nse_stock_base"
                referencedTableName="nse_stock_base"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>