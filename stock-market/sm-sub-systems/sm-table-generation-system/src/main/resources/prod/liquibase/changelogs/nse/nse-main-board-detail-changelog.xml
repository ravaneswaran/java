<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001" author="Ravaneswaran Chinnasamy">
        <createTable tableName="nse_main_board_detail">
            <column name="id" type="varchar2(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="stock_base_id" type="varchar2(100)"/>
            <column name="symbol" type="varchar2(100)"/>
            <column name="open_price" type="double"/>
            <column name="high_price" type="double"/>
            <column name="low_price" type="double"/>
            <column name="previous_close_price" type="double"/>
            <column name="last_traded_price" type="double"/>
            <column name="percentage_change" type="double"/>
            <column name="volume" type="int"/>
            <column name="value" type="double"/>
            <column name="ca" type="datetime"/>
            <column name="created_date" type="datetime"/>
            <column name="modified_date" type="datetime"/>
            <column name="created_by" type="varchar2(100)"/>
            <column name="modified_by" type="varchar2(100)"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="nse_main_board_detail"
                baseColumnNames="stock_base_id"
                constraintName="fk_nse_main_board_detail_nse_stock_base"
                referencedTableName="nse_stock_base"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="002" author="Ravaneswaran Chinnasamy">
        <renameColumn
                tableName="nse_main_board_detail"
                oldColumnName="volume"
                newColumnName="volume_in_shares"
                columnDataType="int"/>
        <renameColumn
                tableName="nse_main_board_detail"
                oldColumnName="value"
                newColumnName="value_in_lakhs"
                columnDataType="double"/>
    </changeSet>

</databaseChangeLog>