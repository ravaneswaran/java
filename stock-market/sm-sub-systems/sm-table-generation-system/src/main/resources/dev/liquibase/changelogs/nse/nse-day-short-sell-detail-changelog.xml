<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001" author="Ravaneswaran Chinnasamy">
        <createTable tableName="nse_day_short_sell_detail">
            <column name="id" type="varchar2(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="stock_base_id" type="varchar2(100)"/>
            <column name="business_date" type="datetime"/>
            <column name="symbol" type="varchar2(100)"/>
            <column name="security_name" type="varchar2(100)"/>
            <column name="quantity" type="int"/>
            <column name="created_date" type="datetime"/>
            <column name="modified_date" type="datetime"/>
            <column name="created_by" type="varchar2(100)"/>
            <column name="modified_by" type="varchar2(100)"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="nse_day_bulk_deal_detail"
                baseColumnNames="stock_base_id"
                constraintName="fk_nse_day_short_sell_detail_nse_stock_base"
                referencedTableName="nse_stock_base"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="002" author="Ravaneswaran Chinnasamy">
        <dropForeignKeyConstraint
                baseTableName="nse_day_bulk_deal_detail"
                constraintName="fk_nse_day_short_sell_detail_nse_stock_base"/>
    </changeSet>

    <changeSet id="003" author="Ravaneswaran Chinnasamy">
        <addForeignKeyConstraint
                baseTableName="nse_day_bulk_deal_detail"
                baseColumnNames="stock_base_id"
                constraintName="fk_nse_day_short_sell_detail_nse_stock_base"
                referencedTableName="nse_stock_base"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>