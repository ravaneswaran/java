<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>
    <groupId>rave.code.java</groupId>
    <artifactId>stock-market</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>stock-market</name>

    <modules>
        <module>sm-maven-plugin</module>
        <module>sm-sub-systems</module>
        <module>sm-web-systems</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>del-dev-and-prod</id>
                        <!-- runs before jar is packaged -->
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Deleting target/classes/dev and target/classes/prod before packaging..."/>
                                <delete dir="${project.build.directory}/classes/dev"/>
                                <delete dir="${project.build.directory}/classes/prod"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>