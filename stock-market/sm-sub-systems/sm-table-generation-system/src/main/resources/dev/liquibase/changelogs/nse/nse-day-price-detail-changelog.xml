<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001" author="Ravaneswaran Chinnasamy">
        <createTable tableName="nse_day_price_detail">
            <column name="id" type="varchar2(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="stock_base_id" type="varchar2(100)"/>
            <column name="business_date" type="datetime"/>
            <column name="mkt" type="varchar2(100)"/>
            <column name="series" type="varchar2(100)"/>
            <column name="symbol" type="varchar2(100)"/>
            <column name="company_name" type="varchar2(100)"/>
            <column name="previous_close_price" type="varchar2(100)"/>
            <column name="open_price" type="varchar2(100)"/>
            <column name="high_price" type="varchar2(100)"/>
            <column name="low_price" type="varchar2(100)"/>
            <column name="close_price" type="varchar2(100)"/>
            <column name="net_traded_value" type="varchar2(100)"/>
            <column name="net_traded_quantity" type="varchar2(100)"/>
            <column name="index_or_security" type="varchar2(100)"/>
            <column name="corp_index" type="varchar2(100)"/>
            <column name="trades" type="varchar2(100)"/>
            <column name="high_52_week" type="varchar2(100)"/>
            <column name="low_52_week" type="varchar2(100)"/>
            <column name="created_date" type="datetime"/>
            <column name="modified_date" type="datetime"/>
            <column name="created_by" type="varchar2(100)"/>
            <column name="modified_by" type="varchar2(100)"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="nse_day_price_detail"
                baseColumnNames="stock_base_id"
                constraintName="fk_nsedpd_nsesb"
                referencedTableName="nse_stock_base"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="002" author="Ravaneswaran Chinnasamy">
        <dropForeignKeyConstraint
                baseTableName="nse_day_price_detail"
                constraintName="fk_nsedpd_nsesb"/>
    </changeSet>

    <changeSet id="003" author="Ravaneswaran Chinnasamy">
        <addForeignKeyConstraint
                baseTableName="nse_day_price_detail"
                baseColumnNames="stock_base_id"
                constraintName="fk_nsedpd_nsesb"
                referencedTableName="nse_stock_base"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>