<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001" author="Ravaneswaran Chinnasamy">
        <createTable tableName="nse_simple_moving_average_detail">
            <column name="id" type="varchar2(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="stock_base_id" type="varchar2(100)"/>
            <column name="sma_5d" type="double"/>
            <column name="sma_10d" type="double"/>
            <column name="sma_20d" type="double"/>
            <column name="sma_50d" type="double"/>
            <column name="sma_100d" type="double"/>
            <column name="sma_200d" type="double"/>
            <column name="created_date" type="datetime"/>
            <column name="modified_date" type="datetime"/>
            <column name="created_by" type="varchar2(100)"/>
            <column name="modified_by" type="varchar2(100)"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="nse_simple_moving_average_detail"
                baseColumnNames="stock_base_id"
                constraintName="fk_nse_simple_moving_average_detail_nse_stock_base"
                referencedTableName="nse_stock_base"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>